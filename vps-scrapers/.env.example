# VPS Scrapers Configuration
# This file contains the environment configuration for the VPS scrapers service
# Copy this file to .env and adjust the values for your VPS setup

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port the scraper service listens on
# Default: 3333
# This must match the port configured in your Plesk telelistings app's LSTV_SCRAPER_URL
PORT=3333
HOST=0.0.0.0

# =============================================================================
# API KEY AUTHENTICATION
# =============================================================================

# API Key for authentication (REQUIRED)
# This key is used to authenticate requests from your Plesk telelistings app
# to the VPS scrapers service.
#
# IMPORTANT: 
# - This should match the LSTV_SCRAPER_KEY configured in your Plesk telelistings app
# - Change this to a secure random key for production use
# - No default key is provided; the service rejects scrapes until this is set
#
# To generate a secure random key, run:
#   openssl rand -base64 24
#   or
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
LSTV_SCRAPER_KEY=replace_with_a_new_random_key

# Alias for backwards compatibility (prefer LSTV_SCRAPER_KEY above)
# LSTV_API_KEY=replace_with_a_new_random_key

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Enable debug logging for troubleshooting
# Default: false
# Set to "true" to enable detailed logging
DEBUG=false

# Low-impact defaults: cache identical requests and limit browser work.
SCRAPE_CACHE_MINUTES=20
MAX_CONCURRENT_SCRAPES=2
REQUESTS_PER_MINUTE=30

# =============================================================================
# PUPPETEER CONFIGURATION (Optional)
# =============================================================================

# Path to Chrome/Chromium executable
# The installation script should automatically detect and set this
# Uncomment and set if you need to specify a custom path
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Skip Chromium download during npm install
# Set to true if Chrome is installed system-wide
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# =============================================================================
# PLESK TELELISTINGS APP CONFIGURATION REFERENCE
# =============================================================================
#
# On your Plesk telelistings app, you need to set these environment variables
# in the Plesk Node.js settings to match the configuration above:
#
# LSTV_SCRAPER_URL=http://<your-vps-ip>:3333
# LSTV_SCRAPER_KEY=<same-new-random-key>  (must match exactly)
# CRON_SECRET=<your_cron_secret_here>
# ADMIN_PASSWORD=<your_admin_password_here>
#
# Example (use your own values!):
# LSTV_SCRAPER_URL=http://203.0.113.45:3333
# LSTV_SCRAPER_KEY=<same-new-random-key>
# CRON_SECRET=cron_Xy9Pq2Lm8Rt4Wn7Yz5Ua3Bb1
# ADMIN_PASSWORD=admin_secure_password_here
#
# Replace <your-vps-ip> with the actual IP address of this VPS server
# where the scrapers are running
#
# For detailed configuration instructions, see: ENV_CONFIGURATION.md
#
# =============================================================================
