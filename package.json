    "health": "node scripts/health_check.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.83",
    "axios": "^1.13.2",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.1",
    "form-data": "^4.0.5",
    "multer": "^2.0.2",
    "ssh2": "^1.17.0"
