{
  "name": "telegram-sports-bot",
  "version": "2.0.0",
  "description": "Free UK football TV listings, daily Telegram digests and branded fixture posters",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node tests/run_all_tests.js",
    "test:integration": "RUN_NETWORK_TESTS=1 node tests/run_all_tests.js",
    "test:lstv": "node tests/lstv.test.js",
